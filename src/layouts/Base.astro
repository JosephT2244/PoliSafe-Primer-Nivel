---
// Un código de: Joseph Ubaldo Trejo Hernández
// Layout común: metadatos, SEO, datos estructurados, encabezado y pie.
import '../styles/global.css';
import fuente from '../assets/fuentes/roboto-flex-latin.woff2?url';
import Encabezado from '../components/Encabezado.astro';
import Pie from '../components/Pie.astro';
import { sitio } from '../datos/sitio';
import { getImage } from 'astro:assets';
import icono from '../assets/marca/icono_app.png';
import compartir from '../assets/marca/enfermera.png';

interface Props {
  titulo: string;
  descripcion?: string;
  indexar?: boolean;
  datosEstructurados?: Record<string, unknown>[];
  claseCuerpo?: string;
}

const { titulo, descripcion = sitio.descripcion, indexar = true, datosEstructurados = [], claseCuerpo } = Astro.props;
const tituloCompleto = titulo === sitio.nombre ? `${sitio.nombre}, ${sitio.descripcionCorta}` : `${titulo} | ${sitio.nombre}`;
// El dominio se fija al publicar (variable SITIO_URL). Sin él, el sitio no inventa enlaces absolutos.
const absoluta = (ruta: string) => (Astro.site ? new URL(ruta, Astro.site).href : undefined);
const canonica = absoluta(Astro.url.pathname);
const favicon32 = await getImage({ src: icono, width: 32, height: 32, format: 'png' });
const favicon180 = await getImage({ src: icono, width: 180, height: 180, format: 'png' });
const imagenSocial = await getImage({ src: compartir, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const organizacion = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: sitio.nombre,
  url: absoluta(import.meta.env.BASE_URL),
  logo: absoluta(favicon180.src),
  email: sitio.correo,
  description: sitio.descripcion,
  founder: { '@type': 'Person', name: 'Joseph Ubaldo Trejo Hernández' },
  address: { '@type': 'PostalAddress', addressRegion: 'Jalisco', addressCountry: 'MX' },
};
const estructurados = [organizacion, ...datosEstructurados];
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {indexar ? canonica && <link rel="canonical" href={canonica} /> : <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#660033" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon32.src} />
    <link rel="apple-touch-icon" href={favicon180.src} />
    {Astro.site && <link rel="sitemap" href="/sitemap-index.xml" />}
    <link rel="preload" href={fuente} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    {canonica && <meta property="og:url" content={canonica} />}
    <meta property="og:image" content={absoluta(imagenSocial.src) ?? imagenSocial.src} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {estructurados.map((dato) => <script type="application/ld+json" set:html={JSON.stringify(dato)} />)}
  </head>
  <body class={claseCuerpo}>
    <a class="salto" href="#contenido">Ir al contenido principal</a>
    <Encabezado />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Pie />
    <script>
      import '../scripts/movimiento';
    </script>
  </body>
</html>
