---
// Un código de: Joseph Ubaldo Trejo Hernández
// Marco de ventana para capturas reales de la app en tableta o en el navegador.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  imagen: ImageMetadata;
  alt: string;
  titulo?: string;
  prioridad?: boolean;
  tamanos?: string;
}
const { imagen, alt, titulo = 'PoliSafe Primer Nivel', prioridad = false, tamanos = '(max-width: 900px) 92vw, 760px' } = Astro.props;
---

<figure class="ventana">
  <div class="barra" aria-hidden="true">
    <span class="titulo">{titulo}</span>
    <span class="controles"><i></i><i></i><i></i></span>
  </div>
  <Picture
    src={imagen}
    alt={alt}
    formats={['avif']}
    fallbackFormat="webp"
    widths={[640, 960, 1440]}
    sizes={tamanos}
    loading={prioridad ? 'eager' : 'lazy'}
    decoding="async"
  />
</figure>

<style>
  .ventana {
    margin: 0;
    overflow: hidden;
    border-radius: 14px;
    background: var(--superficie);
    box-shadow:
      0 0 0 1px var(--borde),
      var(--sombra-3);
  }

  .barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 34px;
    padding-inline: 14px 10px;
    background: var(--superficie-2);
    border-bottom: 1px solid var(--borde);
    font-size: 12px;
    color: var(--texto-2);
  }

  .controles {
    display: flex;
    gap: 14px;
  }

  .controles i {
    width: 10px;
    height: 10px;
    border: 1.5px solid currentColor;
    border-radius: 2px;
    opacity: 0.55;
  }

  .ventana :global(img) {
    width: 100%;
    aspect-ratio: 1440 / 900;
    object-fit: cover;
  }
</style>
